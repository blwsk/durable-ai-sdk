{
  "name": "durable-ai-sdk",
  "version": "0.1.0",
  "description": "Tracing for durable AI SDK agents: one trace per turn, tools nested under the model call that requested them, sub-agents included. Generic to the agent and to the tracing provider.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./braintrust": {
      "types": "./dist/braintrust.d.ts",
      "default": "./dist/braintrust.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "default": "./dist/pi.js"
    }
  },
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc -p tsconfig.build.json && node scripts/link-self.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.{ts,tsx}\" \"**/*.md\" --ignore-path .gitignore"
  },
  "peerDependencies": {
    "ai": ">=7.0.170 <8",
    "braintrust": ">=3",
    "@ai-sdk/harness-pi": ">=1.0.184"
  },
  "peerDependenciesMeta": {
    "braintrust": {
      "optional": true
    },
    "@ai-sdk/harness-pi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/harness-pi": "1.0.184",
    "@types/node": "^26.6.6",
    "ai": "7.0.170",
    "braintrust": "3.44.0",
    "prettier": "^3",
    "typescript": "^7.0.2"
  }
}
